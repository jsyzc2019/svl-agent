</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 8.2 8.12)"><foreignObject style="--ltx-fo-width:38.56em;--ltx-fo-height:10.29em;--ltx-fo-depth:0.19em;font-size:10pt;" height="145.02" overflow="visible" transform="matrix(1 0 0 -1 0 142.33)" width="533.56"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
