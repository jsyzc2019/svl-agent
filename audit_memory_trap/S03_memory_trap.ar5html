<tbody class="ltx_tbody">
<tr id="A2.T1.2.3" class="ltx_tr">
<th id="A2.T1.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">Sonnet-4.6</th>
<td id="A2.T1.2.3.2" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">0.0035</td>
<td id="A2.T1.2.3.3" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">0.3371</td>
<td id="A2.T1.2.3.4" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">0.7895</td>
<td id="A2.T1.2.3.5" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">0.0064</td>
<td id="A2.T1.2.3.6" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">0.3315</td>
<td id="A2.T1.2.3.7" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">0.8129</td></tr>
<tr id="A2.T1.2.4" class="ltx_tr">
