</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 8.2 8.5)"><foreignObject style="--ltx-fo-width:23.06em;--ltx-fo-height:16.29em;--ltx-fo-depth:0.22em;font-size:10pt;" height="228.43" overflow="visible" transform="matrix(1 0 0 -1 0 225.35)" width="319.09"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
