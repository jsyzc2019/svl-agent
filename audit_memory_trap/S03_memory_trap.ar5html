<div id="A1.SS2.SSS0.Px1.p6" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A1.SS2.SSS0.Px1.p6.pic1" class="ltx_picture" height="292.79" overflow="visible" version="1.1" viewBox="0 0 550 292.79" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,292.79) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#404040;" fill="#404040" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.74 L 0 288.06 C 0 290.67 2.12 292.79 4.74 292.79 L 545.26 292.79 C 547.88 292.79 550 290.67 550 288.06 L 550 4.74 C 550 2.12 547.88 0 545.26 0 L 4.74 0 C 2.12 0 0 2.12 0 4.74 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 4.74 L 1.97 269.48 L 548.03 269.48 L 548.03 4.74 C 548.03 3.21 546.79 1.97 545.26 1.97 L 4.74 1.97 C 3.21 1.97 1.97 3.21 1.97 4.74 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 8.2 277.68)"><foreignObject style="--ltx-fo-width:38.56em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="533.56"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
