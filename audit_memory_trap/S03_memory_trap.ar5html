<td id="A2.T1.2.4.3" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;">0.2261</td>
<td id="A2.T1.2.4.4" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;">0.5762</td>
<td id="A2.T1.2.4.5" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;">0.0037</td>
<td id="A2.T1.2.4.6" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;">0.1138</td>
<td id="A2.T1.2.4.7" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;">0.4941</td></tr>
<tr id="A2.T1.2.5" class="ltx_tr">
<th id="A2.T1.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:4.0pt;padding-right:4.0pt;">Sonnet-5</th>
<td id="A2.T1.2.5.2" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;">0.1092</td>
<td id="A2.T1.2.5.3" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;">0.1373</td>
<td id="A2.T1.2.5.4" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;">0.3914</td>
<td id="A2.T1.2.5.5" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;">0.0550</td>
<td id="A2.T1.2.5.6" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;">0.0902</td>
<td id="A2.T1.2.5.7" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;">0.3826</td></tr>
<tr id="A2.T1.2.6" class="ltx_tr">
<th id="A2.T1.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:4.0pt;padding-right:4.0pt;">Opus-4.8</th>
<td id="A2.T1.2.6.2" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;">0.0125</td>
<td id="A2.T1.2.6.3" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;">0.1704</td>
<td id="A2.T1.2.6.4" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;">0.1613</td>
<td id="A2.T1.2.6.5" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;">0.0127</td>
<td id="A2.T1.2.6.6" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;">0.1445</td>
<td id="A2.T1.2.6.7" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;">0.1524</td></tr>
